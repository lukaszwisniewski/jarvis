# JARVIS configuration example.
# Copy to .env and replace the placeholder values: cp .env.example .env
# All settings are defined in app/config.py.
#
# List and mapping values must be written as JSON (for example ["a","b"] or
# {"key": 1}). Comma-separated values are not parsed by the settings loader.

# --- Slack -------------------------------------------------------------------
# Required: used to verify incoming slash-command requests.
SLACK_SIGNING_SECRET=replace-with-your-slack-signing-secret
# Optional: comma-separated Slack user IDs allowed to use the command.
# Leave empty to allow all users.
SLACK_ALLOWED_USER_IDS=

# --- Anthropic ---------------------------------------------------------------
# Required for live answers unless LLM_STUB_MODE=true.
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
# Set to true to return stub responses instead of calling Anthropic.
LLM_STUB_MODE=false
# Optional agent mode (off by default): Claude chooses which sources to search
# through tools instead of always querying all three. AGENT_MAX_TOOL_ROUNDS limits
# the rounds of tool calls per question. Uses ANTHROPIC_MODEL_FAST.
AGENT_MODE=false
AGENT_MAX_TOOL_ROUNDS=4
# LangGraph installs the langsmith package. Leave LANGSMITH_TRACING (and
# LANGCHAIN_TRACING_V2) unset: if enabled, agent state, including retrieved
# content, may be sent to LangSmith.
# Optional model overrides (defaults shown). The fast model generates search
# queries; the synthesis model writes the final answer.
# ANTHROPIC_MODEL_FAST=claude-haiku-4-5
# ANTHROPIC_MODEL_SYNTHESIS=claude-sonnet-4-5

# --- Logging and metrics ---------------------------------------------------
# JSON log lines by default; LOG_FORMAT=text for a readable format.
# At DEBUG, logs include queries, titles, snippets and retrieved context.
# LOG_LEVEL is optional: DEBUG, INFO, WARNING, ERROR or CRITICAL (any case).
# If set, both the API and the worker use it. If unset or empty, the API logs
# at INFO and the worker at Celery's --loglevel (info in Compose).
# LOG_LEVEL=DEBUG
LOG_FORMAT=json
# Port of the worker's metrics endpoint. It only starts when
# PROMETHEUS_MULTIPROC_DIR is set; docker-compose.yml sets that for the
# worker only (on a tmpfs mount). Do not set PROMETHEUS_MULTIPROC_DIR here.
# If you change the port, also change the worker's port mapping in
# docker-compose.yml and the worker target in deploy/monitoring/prometheus.yml
# (both hard-code 9100).
WORKER_METRICS_PORT=9100

# --- Redis / Celery ----------------------------------------------------------
# Docker Compose overrides this with redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0

# --- GitHub ------------------------------------------------------------------
GITHUB_TOKEN=replace-with-your-github-token
# Repositories searched by default. If this is empty, GitHub code search is
# not restricted to any repository, so set it explicitly.
GITHUB_REPOS=["your-org/your-repo"]
# Optional repository lists used with the "cf" / "py" scope prefixes
# (e.g. "/jarvis py how does X work"). Empty lists fall back to GITHUB_REPOS.
GITHUB_CF_REPOS=[]
GITHUB_PY_REPOS=[]
# Optional file-extension filters and ranking weights (defaults shown).
# GITHUB_ALLOWED_EXTENSIONS=[".py", ".md", ".tf"]
# GITHUB_EXTENSION_SCORES={".py": 5, ".md": 2, ".tf": 2}
# GITHUB_CF_ALLOWED_EXTENSIONS=[".cfm", ".cfc"]
# GITHUB_CF_EXTENSION_SCORES={".cfc": 5, ".cfm": 3}
# GITHUB_PY_ALLOWED_EXTENSIONS=[".py", ".md", ".tf"]
# GITHUB_PY_EXTENSION_SCORES={".py": 5, ".md": 2, ".tf": 2}

# --- Jira (Atlassian Cloud REST API v3) ---------------------------------------
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_TOKEN=replace-with-your-atlassian-api-token

# --- Confluence (Atlassian Cloud) ----------------------------------------------
# Site root without /wiki (the connector appends /wiki/rest/api/...).
# Confluence requests authenticate with JIRA_EMAIL and JIRA_TOKEN.
# Leave empty to disable Confluence retrieval.
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net

# --- Retrieval tuning (optional; defaults shown) -------------------------------
# Maximum results kept per source before the final top-10 cut.
# RETRIEVAL_SOURCE_CAPS={"github": 6, "jira": 3, "confluence": 1}
# Keyword lists used for query intent detection and keyword extraction.
# RETRIEVAL_ENDPOINT_INTENT_KEYWORDS=["endpoint", "route", "api"]
# RETRIEVAL_ARCHITECTURE_INTENT_KEYWORDS=["flow", "process", "architecture", "handler", "processor", "worker", "lambda"]
# RETRIEVAL_TABLE_INTENT_KEYWORDS=["table", "tables", "database", "schema", "sql", "column", "columns", "db"]
# RETRIEVAL_QUERY_STOPWORDS=["the", "and", "for", "with", "from", "that", "this", "have", "show", "many", "what", "where", "currently", "please"]
# RETRIEVAL_TABLE_ENTITY_EXCLUDE_KEYWORDS=["table", "tables", "database", "schema", "sql", "column", "columns", "query", "queries", "main", "involved"]
